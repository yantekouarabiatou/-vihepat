NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3309

DB_NAME=vihepat
DB_USER=vihepat
DB_PASS=vihepatpass

JWT_SECRET=change_me_chaine_longue_32_caracteres_minimum
JWT_EXPIRES=7d
JWT_REFRESH_SECRET=change_me_autre_chaine_longue_32_caracteres
JWT_REFRESH_EXPIRES=30d

CORS_ORIGIN=http://localhost:5173

# Requis pour le chat IA de signalement de symptômes (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Requis pour l'analyse de la note vocale du triage (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Configuration SMTP (Brevo / Sendinblue ou autre fournisseur)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=contact@vihepat.org
MAIL_FROM_NAME="VIHEPAT Santé"

# Les codes d'habilitation soignant sont désormais par structure de santé
# (table `structures`, colonne code_invitation) — voir backend/src/seed.ts.
