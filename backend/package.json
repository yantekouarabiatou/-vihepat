{
  "name": "vihepat-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API VIHEPAT - Assistant de suivi VIH & hépatites",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "sequelize-cli db:migrate",
    "db:rollback": "sequelize-cli db:migrate:undo",
    "db:seed": "ts-node --transpile-only src/seed.ts",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && npm run db:seed",
    "ia:audio": "ts-node --transpile-only scripts/triage-audio.ts",
    "ia:parite": "ts-node --transpile-only scripts/export-parite.ts",
    "prod:installer": "npm install --omit=dev --no-audit --no-fund",
    "prod:verifier-base": "node scripts/verifier-base.js",
    "ia:sync-triage": "node -e \"const f=require('fs');if(f.readFileSync('src/ia/triage.ts','utf8')!==f.readFileSync('../frontend/src/lib/triage.ts','utf8')){console.error('triage.ts diverge entre backend et frontend');process.exit(1)}console.log('triage.ts identique')\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.0.12",
    "sequelize": "^6.37.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
